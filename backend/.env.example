# ============================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# ============================================
# Generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Generate ENCRYPTION_KEY with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ============================================

# Environment (development or production)
ENVIRONMENT=development

# Frontend Configuration
FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAMESITE=lax
ACCESS_TOKEN_EXPIRE_MINUTES=120
SECURE_COOKIES=false

# Security Keys - MUST BE CHANGED IN PRODUCTION!
SECRET_KEY=your_secret_key_here_minimum_32_chars
ENCRYPTION_KEY=your_encryption_key_here
DATA_RETENTION_DAYS=365
# For local development (PostgreSQL running on host or via docker-compose.local.yml)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/dermatack
# For Docker Compose full stack (PostgreSQL in container named 'db')
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/dermatack
TRANSCRIBE_BACKEND=local
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
WHISPER_MODEL=base
# Optional: For OpenAI Whisper API (if TRANSCRIBE_BACKEND=openai)
OPENAI_API_KEY=
S3_ENABLED=false
# Optional: comma separate FRONTEND_ORIGIN for multiple origins e.g. https://app.example.com,https://admin.example.com
# Optional: S3_BUCKET=your-bucket
# Optional: S3_PUBLIC_URL=https://cdn.example.com
ALLOWED_EXTERNAL_HOSTS=generativelanguage.googleapis.com,api.openai.com,s3.amazonaws.com
DPO_EMAIL=dpo@example.com
DPO_PHONE=+91-00000-00000
GRIEVANCE_EMAIL=grievance@example.com
GRIEVANCE_PHONE=+91-11111-11111
PRIVACY_POLICY_MD=policies/privacy.md
TERMS_MD=policies/terms.md
